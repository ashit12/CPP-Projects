.vscode/
.idea/
*.xcodeproj/
*.xcworkspace/
*.suo
*.user
*.sln.docstates
.vs/

# clangd / LSP
.cache/
.clangd/

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*

# ── Misc ──────────────────────────────────────────────────────────────────────
*.log
*.tmp
*.swp
*~
